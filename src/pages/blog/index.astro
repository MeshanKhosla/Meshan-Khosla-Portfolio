---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import GridCard from '../../components/GridCard.astro';
import SearchBox from '../../components/SearchBox.astro';
import Pagination from '../../components/Pagination.astro';
import { getBlogImageSources } from '../../utils/blog-image';

// Get all blog posts sorted by date
const allPosts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const pageSize = 9;
const posts = allPosts.slice(0, pageSize);
const totalPages = Math.ceil(allPosts.length / pageSize);

// Format date helper
const formatDate = (date: Date) => {
  return date.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
  });
};

---

<Layout title="Blog" description="Technical blog posts about distributed systems, software engineering, and more.">
  <div class="p-6 lg:p-12">
    <!-- Header -->
    <header class="max-w-4xl mb-10">
      <h1 class="font-serif text-3xl lg:text-4xl font-semibold mb-4">Blog</h1>
      <p class="text-charcoal-muted dark:text-sand-muted text-balance mb-4">
        Things I'm learning about distributed systems, software engineering, and anything else. Less of a blog, more of a learning log.
      </p>
      <a
        href="/rss.xml"
        class="inline-flex items-center gap-2 text-sm text-charcoal-muted dark:text-sand-muted hover:text-accent dark:hover:text-accent-light transition-colors"
      >
        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M6.18 17.82a2.18 2.18 0 1 1-4.36 0 2.18 2.18 0 0 1 4.36 0zM1.82 8.73v3.01c6.02 0 10.92 4.9 10.92 10.92h3.01c0-7.68-6.25-13.93-13.93-13.93zm0-5.18v3.01c9.97 0 18.09 8.12 18.09 18.1h3.01c0-11.63-9.47-21.11-21.1-21.11z" />
        </svg>
        RSS Feed
      </a>
    </header>

    <!-- Search / Filter -->
    <div class="max-w-md mb-10">
      <SearchBox />
    </div>

    <!-- Posts Grid -->
    <div data-posts-grid class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-10">
      {posts.map((post) => (
        <GridCard
          title={post.data.title}
          description={post.data.description}
          url={`/blog/${post.id}/`}
          image={getBlogImageSources(post.data.heroImage).src}
          imageSrcset={getBlogImageSources(post.data.heroImage).srcset}
          imageSizes="(min-width: 1024px) calc((100vw - 17rem) / 3), (min-width: 768px) 50vw, 100vw"
          meta={formatDate(post.data.pubDate)}
          slug={post.id}
        />
      ))}
    </div>

    <div data-search-results class="hidden grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-10" aria-live="polite"></div>

    <div data-pagination>
      <Pagination currentPage={1} totalPages={totalPages} baseUrl="/blog/" />
    </div>
  </div>
</Layout>
