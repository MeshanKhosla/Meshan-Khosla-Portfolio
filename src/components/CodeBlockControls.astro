<script>
  function initializeCodeBlocks() {
    document.querySelectorAll<HTMLPreElement>('.blog-content pre').forEach((pre) => {
      if (pre.parentElement?.classList.contains('blog-code-block')) return;

      const wrapper = document.createElement('div');
      wrapper.className = 'blog-code-block';
      pre.before(wrapper);
      wrapper.append(pre);
      pre.dataset.wrapLines = 'false';

      const toolbar = document.createElement('div');
      toolbar.className = 'blog-code-toolbar';
      const button = document.createElement('button');
      button.type = 'button';
      button.className = 'blog-code-wrap';
      button.setAttribute('aria-pressed', 'false');
      button.title = 'Wrap lines';
      button.innerHTML = `<svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M4 6h16M4 11h12a4 4 0 0 1 0 8h-4m3-3-3 3 3 3M4 16h3" /></svg><span>Wrap lines</span>`;
      button.addEventListener('click', () => {
        const wrapping = pre.dataset.wrapLines !== 'true';
        pre.dataset.wrapLines = String(wrapping);
        button.setAttribute('aria-pressed', String(wrapping));
        button.title = wrapping ? 'Unwrap lines' : 'Wrap lines';
      });
      toolbar.append(button);
      wrapper.prepend(toolbar);
    });
  }

  initializeCodeBlocks();
  document.addEventListener('astro:page-load', initializeCodeBlocks);
</script>

<style is:global>
  .blog-content pre {
    white-space: pre !important;
    overflow-wrap: normal;
    word-break: normal;
  }

  .blog-content pre code {
    white-space: inherit;
    overflow-wrap: inherit;
    word-break: inherit;
  }

  .blog-code-block {
    margin-block: 1.5em;
    min-width: 0;
  }

  .blog-code-toolbar {
    display: flex;
    justify-content: flex-end;
    margin-bottom: 0.375rem;
  }

  .blog-code-wrap {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.375rem 0.625rem;
    border: 1px solid;
    border-radius: 0.5rem;
    font-family: inherit;
    font-size: 0.75rem;
    line-height: 1.5;
    cursor: pointer;
    @apply text-charcoal-muted border-cream-300 dark:text-sand-muted dark:border-ink-lighter;
  }

  .blog-code-wrap:hover,
  .blog-code-wrap[aria-pressed='true'] {
    @apply bg-cream-200 text-charcoal dark:bg-ink-lighter dark:text-sand;
  }

  .blog-code-wrap:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 2px;
  }

  .blog-code-block pre {
    margin-block: 0;
  }

  .blog-code-block pre[data-wrap-lines='true'] {
    white-space: pre-wrap !important;
    overflow-wrap: anywhere;
    word-break: normal;
  }
</style>
